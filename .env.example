# Spring Profiles
SPRING_PROFILES_ACTIVE_DOCKER=docker
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Shared Credentials
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432

# Auth Service
AUTH_SERVICE_PORT=8081
AUTH_DB_NAME=auth_service
AUTH_DB_PORT=5432
DB_URL_AUTH=jdbc:postgresql://auth-db:5432/auth_service

# Order Service
ORDER_SERVICE_PORT=8082
ORDER_DB_NAME=order_service
ORDER_DB_PORT=5434
DB_URL_ORDER=jdbc:postgresql://order-db:5432/order_service

# Payment Service
PAYMENT_SERVICE_PORT=8084
MONGODB_URI=mongodb://localhost:27017/payment_service
PAYMENT_MONGODB_PORT=27018

# User Service
USER_SERVICE_PORT=8080
USER_DB_NAME=user_service
USER_DB_PORT=5433
DB_URL_USER=jdbc:postgresql://user-db:5432/user_service

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT=2000ms
CACHE_TTL=300000

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Liquibase
SHOW_SQL=false
LIQUIBASE_ENABLED=true

# API Gateway
API_GATEWAY_PORT=8083
API_GATEWAY_URL=http://api-gateway:8083

# Internal token для API Gateway
API_GATEWAY_INTERNAL_TOKEN=your_gateway-internal-secret-token

# Обновляем URL для Order Service
USER_SERVICE_BASE_URL=http://user-service:8080

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092
KAFKA_TOPIC_PAYMENT_EVENTS=payment-events

FRONTEND_PORT=4200